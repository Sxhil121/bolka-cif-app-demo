# Copy this file to .env.local (git-ignored) for local development.
# In production, set the same three variables in Vercel:
#   Project -> Settings -> Environment Variables
# Never commit real values for these.

# Tata Smartflo login email (used to fetch a short-lived access token
# server-side — see app/api/click-to-call/route.js)
TATA_EMAIL=

# Tata Smartflo login password
TATA_PASSWORD=

# The caller ID (assigned/pilot number) Tata should present to the
# destination number for outbound click-to-call
TATA_CALLER_ID=
