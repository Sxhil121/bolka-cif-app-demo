# Copy this file to .env.local (git-ignored) for local development.
# In production, set the same variables in Vercel:
#   Project -> Settings -> Environment Variables
# Never commit real values for these.

# Tata Smartflo login email/password (JWT auth). Not currently used by
# the calling code path (see TATA_CTC_SUPPORT_API_KEY below), but kept
# for reference / possible future use of other Tata APIs (e.g. call
# records) that need a login-based bearer token.
TATA_EMAIL=
TATA_PASSWORD=

# The caller ID (assigned/pilot number) Tata should present to the
# destination number for outbound click-to-call. Not currently used by
# the calling code path (baked into TATA_CTC_SUPPORT_API_KEY instead) but
# kept for reference / possible future direct click_to_call use.
TATA_CALLER_ID=

# Click to Call Support API key from the Smartflo dashboard
# (API Connect -> Click to Call Support API). This key is generated
# against a specific destination — Mobile or Extension — configured in
# the dashboard when the key was created, e.g. "Assigned To: Sandeep
# (Extension)". This is what the app actually calls to place a real call.
TATA_CTC_SUPPORT_API_KEY=
